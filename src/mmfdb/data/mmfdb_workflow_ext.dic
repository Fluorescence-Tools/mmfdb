##############################################################################
# mmfdb_workflow_ext.dic — MMFDB workflow, provenance, and deposit-bundle
# categories.
#
# This dictionary DESCRIBES the extra categories MMFDB writes into a
# self-contained deposit CIF (see mmfdb.workflow.export.write_single_cif): the
# workflow definition, its provenance graph, and the embedded data files. Unlike
# mmfdb_flr_ext.dic, these categories are NOT database-backed — they carry no
# _mmfdb_schema.* items and are not part of the runtime schema (they are not in
# MmcifDictionary.BUNDLED_DICTS). Their sole purpose is to make a single deposit
# CIF self-describing and reproducible: the categories below, plus the embedded
# workflow YAML and the embedded original data files, are everything needed to
# re-run the analysis.
##############################################################################

data_mmfdb_workflow_ext.dic

    _dictionary.title            mmfdb_workflow_ext.dic
    _dictionary.datablock_id     mmfdb_workflow_ext.dic
    _dictionary.version          1.0

#############
## CATEGORY: mmfdb_workflow
#############

save_mmfdb_workflow
   _category.id              mmfdb_workflow
   _category.description
;     The declarative workflow that produced the deposit: its identity and the
;     verbatim YAML definition, so the pipeline can be re-run. One row.
;
   _category.mandatory_code  no
   _category_key.name        "_mmfdb_workflow.name"

save__mmfdb_workflow.name
   _item.name                "_mmfdb_workflow.name"
   _item.category_id         mmfdb_workflow
   _item_type.code           line
   _item.mandatory_code      yes

save__mmfdb_workflow.version
   _item.name                "_mmfdb_workflow.version"
   _item.category_id         mmfdb_workflow
   _item_type.code           int
   _item.mandatory_code      no

save__mmfdb_workflow.description
   _item.name                "_mmfdb_workflow.description"
   _item.category_id         mmfdb_workflow
   _item_type.code           text
   _item.mandatory_code      no

save__mmfdb_workflow.definition
   _item.name                "_mmfdb_workflow.definition"
   _item.category_id         mmfdb_workflow
   _item_type.code           text
   _item.mandatory_code      no
   _item_description.description
;     The verbatim workflow YAML, embedded so the deposit is reproducible
;     without any external file.
;

