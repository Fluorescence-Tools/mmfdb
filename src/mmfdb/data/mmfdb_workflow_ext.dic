#############
## CATEGORY: mmfdb_container
#############

save_mmfdb_container
   _category.id              mmfdb_container
   _category.description
;     What a serialised container is, written into the container itself.
;
;     A photon container (see the PTO.MFDB profile) carries results tagged with
;     terms from this dictionary family.  Four things can drift independently --
;     the container format, the profile that constrains it, the dictionary the
;     terms come from, and the application that wrote it -- so a file that
;     records only one of them cannot be diagnosed when it disagrees with a
;     reader.  These items are the stamp.
;
;     Like the rest of this dictionary they describe a SERIALIZATION and are not
;     database-backed: there is no mmfdb_container table, and this file is
;     deliberately absent from MmcifDictionary.BUNDLED_DICTS so that schema
;     reconciliation does not materialise one.
;
   _category.mandatory_code  no
   _category_key.name        "_mmfdb_container.profile"

save__mmfdb_container.profile
   _item.name                "_mmfdb_container.profile"
   _item.category_id         mmfdb_container
   _item_type.code           line
   _item.mandatory_code      yes
   _item_description.description
;     Name of the profile the file conforms to, e.g. ``PTO.MFDB``.

save__mmfdb_container.profile_version
   _item.name                "_mmfdb_container.profile_version"
   _item.category_id         mmfdb_container
   _item_type.code           code
   _item.mandatory_code      yes
   _item_description.description
;     Version of the profile that wrote the file.  A reader accepts a higher
;     one and skips what it does not know.

save__mmfdb_container.profile_read_version
   _item.name                "_mmfdb_container.profile_read_version"
   _item.category_id         mmfdb_container
   _item_type.code           int
   _item.mandatory_code      yes
   _item_description.description
;     Minimum profile version required to read the file correctly.  A reader
;     implementing less than this must refuse it rather than misread it.

save__mmfdb_container.format
   _item.name                "_mmfdb_container.format"
   _item.category_id         mmfdb_container
   _item_type.code           code
   _item.mandatory_code      no
   _item_description.description
;     The container format underneath the profile, e.g. ``pto``.

save__mmfdb_container.format_version
   _item.name                "_mmfdb_container.format_version"
   _item.category_id         mmfdb_container
   _item_type.code           code
   _item.mandatory_code      no
   _item_description.description
;     Version of that container format.

save__mmfdb_container.dictionary_version
   _item.name                "_mmfdb_container.dictionary_version"
   _item.category_id         mmfdb_container
   _item_type.code           code
   _item.mandatory_code      no
   _item_description.description
;     ``_dictionary.version`` of the MMFDB extension dictionary whose terms the
;     file is tagged with.

save__mmfdb_container.dictionary_hash
   _item.name                "_mmfdb_container.dictionary_hash"
   _item.category_id         mmfdb_container
   _item_type.code           code
   _item.mandatory_code      no
   _item_description.description
;     SHA-256 of that dictionary as loaded, lowercase hexadecimal.  A version is
;     what an author declares; this is what was actually used, and the two
;     disagree exactly when someone edited a dictionary without bumping it.

#############
## CATEGORY: mmfdb_column
#############

save_mmfdb_column
   _category.id              mmfdb_column
   _category.description
;     What one column of a serialised table is.
;
;     A column carries a name and a dtype, which is enough to read it and not
;     enough to understand it: a burst duration is milliseconds, a lifetime is
;     nanoseconds, and historically that was recorded only in the column name,
;     when whoever wrote it remembered -- "Duration (ms)" and "Tau" sit in the
;     same table.  These are the attributes a column description carries so it
;     is written down instead.
;
;     Like the rest of this dictionary these describe a SERIALIZATION and are
;     not database-backed: there is no mmfdb_column table.
;
   _category.mandatory_code  no
   _category_key.name        "_mmfdb_column.name"

save__mmfdb_column.name
   _item.name                "_mmfdb_column.name"
   _item.category_id         mmfdb_column
   _item_type.code           line
   _item.mandatory_code      yes
   _item_description.description
;     The column's name, and the key it is looked up by.

save__mmfdb_column.units
   _item.name                "_mmfdb_column.units"
   _item.category_id         mmfdb_column
   _item_type.code           code
   _item.mandatory_code      no
   _item_description.description
;     The physical unit of the column's values.
;
;     Spellings follow mmCIF's ITEM_UNITS_LIST wherever it has the unit, so
;     "seconds", "nanoseconds", "hertz" and "counts" are the community's words --
;     15 of the 28 here are already its own.  Its 78 codes have an odd gap: it
;     carries nanoseconds and femtoseconds but neither milliseconds nor
;     picoseconds, and no concentration, rate multiple or count-of-photons.
;     Those 13 are added here rather than invented at each call site.
;
;     "dimensionless" is for a ratio that genuinely has no unit -- an efficiency,
;     an anisotropy -- and is not the same as saying nothing, which means the
;     unit is unknown.
    loop_
    _item_enumeration.value
      hours
      minutes
      seconds
      milliseconds
      microseconds
      nanoseconds
      picoseconds
      femtoseconds
      hertz
      kilohertz
      megahertz
      counts
      counts_per_second
      photons
      nanometres
      micrometres
      angstroms
      pixels
      degrees
      radians
      celsius
      kelvins
      molar
      millimolar
      micromolar
      nanomolar
      picomolar
      dimensionless

save__mmfdb_column.item
   _item.name                "_mmfdb_column.item"
   _item.category_id         mmfdb_column
   _item_type.code           line
   _item.mandatory_code      no
   _item_description.description
;     The mmCIF item this column corresponds to, when there is one, so a table
;     can be projected onto the dictionary rather than matched by name.

save__mmfdb_column.description
   _item.name                "_mmfdb_column.description"
   _item.category_id         mmfdb_column
   _item_type.code           text
   _item.mandatory_code      no
   _item_description.description
;     Prose about the column, for a reader who has only the file.

#############
## CATEGORY: mmfdb_units
#############

save_mmfdb_units
   _category.id              mmfdb_units
   _category.description
;     One row per unit: its code, how it is written for a person, and what it
;     is in SI.
;
;     mmCIF's ITEM_UNITS_LIST gives codes and prose and nothing else, so every
;     consumer that wanted to *show* a unit invented its own abbreviation and
;     every consumer that wanted to *convert* one invented its own factor.  In
;     ChiSurf alone that produced three in-band conventions for saying the same
;     thing -- "Duration (ms)" in a burst table, "Name | unit" in an expression
;     column header, and bare dictionaries of factors in the DEER and FCS
;     readers -- none of which agreed on spelling.
;
;     This is the one table.  A display layer reads `symbol`; a converter reads
;     `si_factor` and `si_unit`; nothing parses a unit back out of a name.
;
;     Serialization vocabulary, like the rest of this dictionary: no table is
;     materialised for it.
;
   _category.mandatory_code  no
   _category_key.name        "_mmfdb_units.code"

save__mmfdb_units.code
   _item.name                "_mmfdb_units.code"
   _item.category_id         mmfdb_units
   _item_type.code           code
   _item.mandatory_code      yes
   _item_description.description
;     The canonical code, as used by _mmfdb_column.units and _item_units.code.
;     Follows ITEM_UNITS_LIST where that has the unit.

save__mmfdb_units.symbol
   _item.name                "_mmfdb_units.symbol"
   _item.category_id         mmfdb_units
   _item_type.code           line
   _item.mandatory_code      yes
   _item_description.description
;     How the unit is written for a person: "ns", "kHz", "ms".  This is what an
;     axis label or a table header shows, and having it here is what stops each
;     display inventing its own.

save__mmfdb_units.si_factor
   _item.name                "_mmfdb_units.si_factor"
   _item.category_id         mmfdb_units
   _item_type.code           float
   _item.mandatory_code      no
   _item_description.description
;     Multiply a value in this unit by this to get _mmfdb_units.si_unit.
;     Absent for a unit that is not a scaled SI quantity.

save__mmfdb_units.si_unit
   _item.name                "_mmfdb_units.si_unit"
   _item.category_id         mmfdb_units
   _item_type.code           code
   _item.mandatory_code      no
   _item_description.description
;     The SI (or SI-derived) unit _mmfdb_units.si_factor converts to.

save_

# The table itself. A data-block-level loop, not a definition -- the same shape
# mmCIF's own ITEM_UNITS_LIST uses, so a reader that can walk one walks both.

    loop_
    _mmfdb_units.code
    _mmfdb_units.symbol
    _mmfdb_units.si_factor
    _mmfdb_units.si_unit
      hours              h        3600.0     seconds
      minutes            min      60.0       seconds
      seconds            s        1.0        seconds
      milliseconds       ms       1e-3       seconds
      microseconds       us       1e-6       seconds
      nanoseconds        ns       1e-9       seconds
      picoseconds        ps       1e-12      seconds
      femtoseconds       fs       1e-15      seconds
      hertz              Hz       1.0        hertz
      kilohertz          kHz      1e3        hertz
      megahertz          MHz      1e6        hertz
      counts             counts   .          .
      counts_per_second  cps      1.0        hertz
      photons            photons  .          .
      nanometres         nm       1e-9       metres
      micrometres        um       1e-6       metres
      angstroms          A        1e-10      metres
      pixels             px       .          .
      degrees            deg      .          .
      radians            rad      .          .
      celsius            C        .          .
      kelvins            K        1.0        kelvins
      molar              M        1.0        molar
      millimolar         mM       1e-3       molar
      micromolar         uM       1e-6       molar
      nanomolar          nM       1e-9       molar
      picomolar          pM       1e-12      molar
      dimensionless      .        1.0        .

#
###########################################################################
#  Burst-analysis column naming
#
#  Migrated 2026-08-10 from tttrlib's okf/nomenclature/mmfdb.dic, which had
#  been a second dictionary: it defined these three categories, which no
#  mmfdb dictionary had, alongside copies of _mmfdb_artifact, _mmfdb_edge and
#  _mmfdb_operation, which mmfdb owns. A copy of a vocabulary drifts from it --
#  that one had, by eighteen terms -- so the copy is gone and the part that was
#  genuinely new lives here, where the vocabulary lives.
#
#  These name the COLUMNS of a burst table: what `Duration (green) (ms)` is,
#  which constant `gG_gR` denotes, and how a derived quantity like FRET
#  efficiency is computed from them. They are the naming half of the burst
#  format, and every writer of one -- tttrlib's CLI, ChiSurf's plugins, ndX --
#  reads them from here.
###########################################################################
#
save_mmfdb_burst_column
   _category.description
;              Data items describing a column in a burst-analysis artifact
               (.bur, .bg4, .br4, .bv4, .2c4, .td4). These are the input
               columns the ndx equation engine reads.
;

   _category.id              mmfdb_burst_column
   _category.mandatory_code  no
   _category_key.name        "_mmfdb_burst_column.column"
#
save_
save__mmfdb_burst_column.first_photon
   _item_description.description
;              Index of the first photon in the burst within the TTTR event
               stream.
;
   _item.name            "_mmfdb_burst_column.first_photon"
   _item.category_id     mmfdb_burst_column
   _item.mandatory_code  yes
   _item_type.code       int
   #
   _mmfdb_burst_column.column   "First Photon"
   _mmfdb_burst_column.symbol   .
   _mmfdb_burst_column.units    index
   _mmfdb_burst_column.source   .bur
   #
save_
save__mmfdb_burst_column.last_photon
   _item_description.description
;              Index of the last photon in the burst (inclusive).
;
   _item.name            "_mmfdb_burst_column.last_photon"
   _item.category_id     mmfdb_burst_column
   _item.mandatory_code  yes
   _item_type.code       int
   #
   _mmfdb_burst_column.column   "Last Photon"
   _mmfdb_burst_column.symbol   .
   _mmfdb_burst_column.units    index
   _mmfdb_burst_column.source   .bur
   #
save_
save__mmfdb_burst_column.duration_ms
   _item_description.description
;              Macro-time span of the entire burst, t_last - t_first, in
               milliseconds.
;
   _item.name            "_mmfdb_burst_column.duration_ms"
   _item.category_id     mmfdb_burst_column
   _item.mandatory_code  yes
   _item_type.code       float
   #
   _mmfdb_burst_column.column   "Duration (ms)"
   _mmfdb_burst_column.symbol   .
   _mmfdb_burst_column.units    ms
   _mmfdb_burst_column.source   .bur
   #
save_
save__mmfdb_burst_column.duration_green_ms
   _item_description.description
;              Macro-time span of the green-detector photons within the burst.
               t_last(green) - t_first(green). Sentinel -1.0 when the burst
               has no green photons. This is the Tg in the ndx equation
               Tg-Tr(ms) = Duration(green) - Duration(red). It is a macro-time
               (burst) duration, NOT a TCSPC micro-time difference.
;
   _item.name            "_mmfdb_burst_column.duration_green_ms"
   _item.category_id     mmfdb_burst_column
   _item.mandatory_code  no
   _item_type.code       float
   #
   _mmfdb_burst_column.column   "Duration (green) (ms)"
   _mmfdb_burst_column.symbol   Tg
   _mmfdb_burst_column.units    ms
   _mmfdb_burst_column.source   .bur
   #
save_
save__mmfdb_burst_column.duration_red_ms
   _item_description.description
;              Macro-time span of the red-detector photons within the burst.
               t_last(red) - t_first(red). Sentinel -1.0 when the burst has
               no red photons. This is the Tr in Tg-Tr(ms).
;
   _item.name            "_mmfdb_burst_column.duration_red_ms"
   _item.category_id     mmfdb_burst_column
   _item.mandatory_code  no
   _item_type.code       float
   #
   _mmfdb_burst_column.column   "Duration (red) (ms)"
   _mmfdb_burst_column.symbol   Tr
   _mmfdb_burst_column.units    ms
   _mmfdb_burst_column.source   .bur
   #
save_
save__mmfdb_burst_column.mean_macro_time_ms
   _item_description.description
;              Midpoint of the burst's first and last photon macro times,
               (t_first + t_last) / 2, in ms. Despite the name this is a
               midpoint, not a photon-weighted mean.
;
   _item.name            "_mmfdb_burst_column.mean_macro_time_ms"
   _item.category_id     mmfdb_burst_column
   _item.mandatory_code  yes
   _item_type.code       float
   #
   _mmfdb_burst_column.column   "Mean Macro Time (ms)"
   _mmfdb_burst_column.symbol   .
   _mmfdb_burst_column.units    ms
   _mmfdb_burst_column.source   .bur
   #
save_
