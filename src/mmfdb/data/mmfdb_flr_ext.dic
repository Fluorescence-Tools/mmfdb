########################################
## mmfdb_reagent_usage (PRD-15)          #
########################################

save_mmfdb_reagent_usage
   _category.id              mmfdb_reagent_usage
   _category.description
;     Many-to-many link of a reagent lot to what used it — an operation (a measurement
;     or processing step), a setup (e.g. an installed filter set), or a sample (e.g. a
;     labeling dye lot).  Orthogonal to those tables.
;
   _category.mandatory_code  no
   _category_key.name        "_mmfdb_reagent_usage.usage_row_id"

save__mmfdb_reagent_usage.usage_row_id
   _item.name                "_mmfdb_reagent_usage.usage_row_id"
   _item.category_id         mmfdb_reagent_usage
   _item_type.code           int
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_reagent_usage
   _mmfdb_schema.column_name usage_row_id

save__mmfdb_reagent_usage.lot_id
   _item.name                "_mmfdb_reagent_usage.lot_id"
   _item.category_id         mmfdb_reagent_usage
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_reagent_usage
   _mmfdb_schema.column_name lot_id
   _item_description.description
;     References mmfdb_reagent_lot.lot_id (a logical reference; the dictionary-generated
;     lot_id code key is not emitted as a PRIMARY KEY, so no hard FK — the repository
;     manages reagent-usage integrity, as for mmfdb_study_member.study_id).

save__mmfdb_reagent_usage.target_type
   _item.name                "_mmfdb_reagent_usage.target_type"
   _item.category_id         mmfdb_reagent_usage
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_reagent_usage
   _mmfdb_schema.column_name target_type
    loop_
    _item_enumeration.value
      operation
      setup
      sample

save__mmfdb_reagent_usage.target_id
   _item.name                "_mmfdb_reagent_usage.target_id"
   _item.category_id         mmfdb_reagent_usage
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_reagent_usage
   _mmfdb_schema.column_name target_id

save__mmfdb_reagent_usage.role
   _item.name                "_mmfdb_reagent_usage.role"
   _item.category_id         mmfdb_reagent_usage
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_reagent_usage
   _mmfdb_schema.column_name role

