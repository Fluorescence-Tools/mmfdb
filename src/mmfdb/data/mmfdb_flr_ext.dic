############################################
## mmfdb_state_transition_rule (PRD-12)     #
############################################

save_mmfdb_state_transition_rule
   _category.id              mmfdb_state_transition_rule
   _category.description
;     Allowed lifecycle transitions per entity_type.  A transition_state() call is
;     rejected unless a matching (entity_type, from_state, to_state) rule exists; a
;     null from_state declares an allowed initial state.  Seeded from the authored
;     lifecycle definitions (data/state_lifecycle_defs.json).
;
   _category.mandatory_code  no
