########################################
## mmfdb_state_transition (PRD-12 LIMS)  #
########################################

save_mmfdb_state_transition
   _category.id              mmfdb_state_transition
   _category.description
;     Lifecycle transition log (LIMS P1).  One row per state change of a tracked
;     entity (sample / artifact / operation): who moved it, when, from where to
;     where, and why.  The log is the source of truth; an entity's "current state"
;     is the latest non-deleted transition's to_state (optionally cached on the
;     entity).  Allowed transitions are declared in mmfdb_state_transition_rule.
;
   _category.mandatory_code  no
   _category_key.name        "_mmfdb_state_transition.transition_id"

save__mmfdb_state_transition.transition_id
   _item.name                "_mmfdb_state_transition.transition_id"
   _item.category_id         mmfdb_state_transition
   _item_type.code           int
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_state_transition
   _mmfdb_schema.column_name transition_id

save__mmfdb_state_transition.entity_type
   _item.name                "_mmfdb_state_transition.entity_type"
   _item.category_id         mmfdb_state_transition
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_state_transition
   _mmfdb_schema.column_name entity_type
   _item_description.description
;     The kind of entity whose state changed (e.g. sample, artifact, operation).

save__mmfdb_state_transition.entity_id
   _item.name                "_mmfdb_state_transition.entity_id"
   _item.category_id         mmfdb_state_transition
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_state_transition
   _mmfdb_schema.column_name entity_id

save__mmfdb_state_transition.from_state
   _item.name                "_mmfdb_state_transition.from_state"
   _item.category_id         mmfdb_state_transition
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_state_transition
   _mmfdb_schema.column_name from_state
   _item_description.description
;     The prior state; null/empty for the initial transition into a lifecycle.

save__mmfdb_state_transition.to_state
   _item.name                "_mmfdb_state_transition.to_state"
   _item.category_id         mmfdb_state_transition
   _item_type.code           code
