   _item.name                "_flr_chisurf_parameter.ics_alpha"
   _item.category_id         flr_chisurf_parameter
   _item_type.code           float
   _mmfdb_schema.table_name  flr_chisurf_parameter
   _mmfdb_schema.column_name ics_alpha
   _item_description.description
;     Anomalous diffusion exponent alpha in MSD(tau) = 4*D*tau^alpha. 1 is normal diffusion; below 1 is subdiffusion (crowding, transient binding), above 1 is directed transport. Releasing it turns an image-correlation fit into the anomalous/iMSD case.
;
save__flr_chisurf_parameter.rics_frame_dur
   _item.name                "_flr_chisurf_parameter.rics_frame_dur"
