##############################################################################
# mmfdb_flr_ext.dic — the MMFDB extension to the PDB-IHM FLR dictionary.
#
# Two kinds of thing live here, and they are not the same kind of thing:
#
#   * overlays on upstream flr_* categories, which bind an existing community
#     item to a live column or add an item upstream lacks;
#   * the mmfdb_* provenance and LIMS categories, which upstream has no
#     equivalent of at all, and which ARE database-backed — a category here
#     with _mmfdb_schema.* items becomes a table via reconcile_schema.
#
# Consumers cite this version.  A file written against one revision and read
# under another must be able to say so rather than silently mis-bind a renamed
# item, so the version below is not decoration: it is the drift signal.  Bump
# the minor version when terms are added (readers of an older revision stay
# valid), the major version when a term changes meaning or is withdrawn.
##############################################################################

data_mmfdb_flr_ext.dic

    _dictionary.title            mmfdb_flr_ext.dic
    _dictionary.datablock_id     mmfdb_flr_ext.dic
    _dictionary.version          1.7

save_flr_fret_forster_radius
   _category.id              flr_fret_forster_radius
   _category.description
;     ChiSurf extensions to the FLR_FRET_FORSTER_RADIUS category.
;     These fields are used by ChiSurf but are not part of the standard flrCIF dictionary.
;
   _category.mandatory_code  no
   _category_key.name        "_flr_fret_forster_radius.id"

save__flr_fret_forster_radius.id
   _item.name                "_flr_fret_forster_radius.id"
   _item.category_id         flr_fret_forster_radius
   _mmfdb_schema.table_name  flr_fret_forster_radius
   _mmfdb_schema.column_name forster_radius_id

save__flr_fret_forster_radius.sample_id
   _item.name                "_flr_fret_forster_radius.sample_id"
   _item.category_id         flr_fret_forster_radius
   _mmfdb_schema.table_name  flr_fret_forster_radius
   _mmfdb_schema.column_name sample_id

save__flr_fret_forster_radius.kappa_squared
   _item.name                "_flr_fret_forster_radius.kappa_squared"
   _item.category_id         flr_fret_forster_radius
   _item.mandatory_code      no
   _item_type.code           float
   _item_default.value       0.666667
   _mmfdb_schema.table_name  flr_fret_forster_radius
   _mmfdb_schema.column_name kappa_squared
   _item_description.description
;     Orientation factor kappa squared for FRET pair.
;     Default is 2/3 (0.666667) for dynamic averaging.
;

save__flr_fret_forster_radius.index_of_refraction
   _item.name                "_flr_fret_forster_radius.index_of_refraction"
   _item.category_id         flr_fret_forster_radius
   _item.mandatory_code      no
   _item_type.code           float
   _item_default.value       1.4
   _mmfdb_schema.table_name  flr_fret_forster_radius
   _mmfdb_schema.column_name index_of_refraction
   _item_description.description
;     Refractive index of the medium for FRET pair.
;     Default is 1.4 for water.
;

save__flr_fret_forster_radius.forster_radius
   _item.name                "_flr_fret_forster_radius.forster_radius"
   _item.category_id         flr_fret_forster_radius
   _item.mandatory_code      yes
   _item_type.code           float
   _item_units.code          angstroms
   _item_default.value       50.0
   _mmfdb_schema.table_name  flr_fret_forster_radius
   _mmfdb_schema.column_name forster_radius
   _item_description.description
;     The Forster radius of the probe pair, in angstroms.
;
;     Upstream flrCIF declares no unit for this item, and the default here was
;     5.0 -- a nanometre value in a field every consumer reads as angstroms,
;     where a Forster radius is 40-70.  Declared and corrected to the same
;     physical quantity, 50 angstroms.

