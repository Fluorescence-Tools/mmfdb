save__mmfdb_operation.command_line
   _item.name                "_mmfdb_operation.command_line"
   _item.category_id         mmfdb_operation
   _item_type.code           text
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_operation
   _mmfdb_schema.column_name command_line
   _item_description.description
;     The command line that produced this operation, for operations run by an
;     external tool (operation_type ``external_tool``).  Stored verbatim as the
;     invocation string so that the exact call is queryable rather than buried
;     in free-form settings_json.  Null for in-process operations.
;

save__mmfdb_operation.exit_code
   _item.name                "_mmfdb_operation.exit_code"
   _item.category_id         mmfdb_operation
   _item_type.code           int
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_operation
   _mmfdb_schema.column_name exit_code
   _item_description.description
;     Process exit status of an externally executed operation: 0 on success,
;     non-zero on failure, negative on POSIX signal termination.  Distinct from
;     ``status``, which is the recorded provenance lifecycle state.  Null for
;     in-process operations.
;

save__mmfdb_operation.settings_json
   _item.name                "_mmfdb_operation.settings_json"
   _item.category_id         mmfdb_operation
   _item_type.code           text
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_operation
   _mmfdb_schema.column_name settings_json
   _item_description.description
;     The operation's parameters, as JSON.  Typed parameters are also written
;     as mmfdb_parameter rows; this is the verbatim bag, so a parameter with no
;     declared schema is still recorded rather than dropped.
;

save__mmfdb_operation.settings_hash
   _item.name                "_mmfdb_operation.settings_hash"
   _item.category_id         mmfdb_operation
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_operation
   _mmfdb_schema.column_name settings_hash
   _item_description.description
;     Digest of the canonicalised settings, and therefore the identity of a
;     run.  Two operations of the same type with the same hash are the same
;     computation, which is what lets a recomputation replace a result instead
;     of accumulating beside it.
;

