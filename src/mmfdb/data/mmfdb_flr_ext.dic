save_mmfdb_label_score
   _category.id              mmfdb_label_score
   _category.description
;     A per-position score of how suitable a site is for attaching a
;     fluorescent label.
;
;     Label-site selection is a scored decision -- is this residue conserved, is
;     it buried, does a tryptophan sit close enough to quench, would a cysteine
;     here be one of several -- and each of those is a named quantity computed
;     by a named method. They had nowhere to live: the tool that computes them
;     writes them into the PDB B-factor column, a field that means "isotropic
;     displacement parameter, in Angstrom squared" and is here carrying a
;     dimensionless suitability score. A reader that believes the file is wrong;
;     a reader that wants the score has to know the convention out of band; and
;     WHICH score is in there is not written down at all, because one column can
;     hold one at a time.
;
;     One row is one score at one position. The position is given the way mmCIF
;     gives a position -- asym_id and seq_id -- so a score joins to the
;     structure and to _flr_poly_probe_position without a private convention.
;
;     ABSENT MEANS NOT COMPUTED. Do not write a sentinel: the tool this was
;     modelled on uses -1 for "excluded" and 0 for "no contribution" in the same
;     column, so a consumer cannot tell an excluded residue from a genuinely
;     zero score, and neither from a real value that happens to be zero. Use
;     _mmfdb_label_score.status to say why a position has no value.
;
;     For readers coming from Labelizer, whose parameters are named by two-letter
;     file tags: cs -> conservation, se -> solvent_exposure,
;     ss -> secondary_structure, ce -> charge_environment,
;     tp -> tryptophan_proximity, cr -> cysteine_resemblance,
;     me -> methionine_exclusion, FRET -> fret_sensitivity. Those tags are that
;     program's private naming and are recorded here only so the correspondence
;     is written down somewhere; they are not values of any item.
;
   _category.mandatory_code  no
   _category_key.name        "_mmfdb_label_score.label_score_id"

save__mmfdb_label_score.label_score_id
   _item.name                "_mmfdb_label_score.label_score_id"
   _item.category_id         mmfdb_label_score
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_label_score
   _mmfdb_schema.column_name label_score_id

save__mmfdb_label_score.artifact_id
   _item.name                "_mmfdb_label_score.artifact_id"
   _item.category_id         mmfdb_label_score
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_label_score
   _mmfdb_schema.column_name artifact_id
   _item_description.description
;     The artifact these scores belong to, so a table of them is provenance-
;     tracked like any other result.
;

save__mmfdb_label_score.score_type
   _item.name                "_mmfdb_label_score.score_type"
   _item.category_id         mmfdb_label_score
   _item_type.code           ucode
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_label_score
   _mmfdb_schema.column_name score_type
   _item_description.description
;     WHAT is being scored. Deliberately coarse, because it is the join key:
;     every tryptophan-proximity score is `tryptophan_proximity` whoever
;     computed it and however, so they can be compared, pooled or plotted
;     against each other without knowing the implementation.
;
;     Which implementation produced a particular value is
;     _mmfdb_label_score.definition, and the two answer different questions --
;     the same split as _mmfdb_operation.operation_type and .algorithm.
;
    loop_
    _item_enumeration.value
    _item_enumeration.detail
      conservation           "evolutionary conservation of the position; a conserved residue is a poor site"
      solvent_exposure       "solvent accessibility; a buried position cannot be reached by a label"
      secondary_structure    "the local secondary structure the position sits in"
      charge_environment     "net charge of the surrounding environment, which perturbs a charged dye"
      tryptophan_proximity   "distance to nearby tryptophans, which quench many dyes"
      cysteine_resemblance   "how much the position already resembles a cysteine, for cysteine chemistry"
      methionine_exclusion   "exclusion of methionines, for methionine-directed chemistry"
      fret_sensitivity       "how informative the position would be about a FRET distance"
      measurement            "agreement with, or support from, an existing measurement"
      combined               "a weighted combination of the scores above -- say which, in the settings"

save__mmfdb_label_score.definition
   _item.name                "_mmfdb_label_score.definition"
   _item.category_id         mmfdb_label_score
   _item_type.code           ucode
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_label_score
   _mmfdb_schema.column_name definition
   _item_description.description
;     WHOSE definition of the score_type this value follows -- the program or
;     published method that defines the number, not a code for it.
;
;     Two programs may both report a "tryptophan proximity score" and not mean
;     the same number: one may count tryptophans inside a radius and another
;     weight them by distance, and the two are not comparable even though the
;     score_type is. Recording the definition is what lets a reader pool the
;     values that may be pooled and separate the ones that may not, without
;     parsing settings whose keys differ per implementation.
;
;     Read it with score_type, which already says what is being scored: the pair
;     (`tryptophan_proximity`, `labelizer`) is "tryptophan proximity, as
;     Labelizer defines it". The value here therefore names only the *source*,
;     and does not repeat the quantity.
;
;     A name here is a name, not an abbreviation. An implementation's internal
;     tag for a score -- Labelizer calls its tryptophan-proximity parameter
;     `tp` and its charge environment `ce` -- is private to that program and
;     means nothing to a reader of this dictionary. If one program grows two
;     incompatible definitions of the same score_type, add a second value that
;     says so in words.
;
;     Absent means the definition was not recorded -- never "the usual one".
;
    loop_
    _item_enumeration.value
    _item_enumeration.detail
      labelizer  "the Labelizer package's own definition, for the scores it computes itself: conservation, charge environment, tryptophan proximity, cysteine resemblance, methionine exclusion, FRET sensitivity, measurement agreement, and their weighted combination"
      consurf    "ConSurf evolutionary conservation grades"
      dssp       "DSSP secondary-structure assignment"
      msms       "MSMS solvent-accessible surface"

save__mmfdb_label_score.asym_id
   _item.name                "_mmfdb_label_score.asym_id"
   _item.category_id         mmfdb_label_score
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_label_score
   _mmfdb_schema.column_name asym_id
   _item_description.description
;     Chain the scored position is in, as mmCIF names a chain.
;

save__mmfdb_label_score.seq_id
   _item.name                "_mmfdb_label_score.seq_id"
   _item.category_id         mmfdb_label_score
   _item_type.code           int
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_label_score
   _mmfdb_schema.column_name seq_id
   _item_description.description
;     Sequence position scored. With asym_id this locates the residue, and is
;     what joins a score to _flr_poly_probe_position -- so "which sites did we
;     score, and which did we label" is one query rather than two files.
;

save__mmfdb_label_score.comp_id
   _item.name                "_mmfdb_label_score.comp_id"
   _item.category_id         mmfdb_label_score
   _item_type.code           ucode
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_label_score
   _mmfdb_schema.column_name comp_id
   _item_description.description
;     Residue type at that position, carried so a table of scores is readable
;     without the structure beside it.
;

save__mmfdb_label_score.value
   _item.name                "_mmfdb_label_score.value"
   _item.category_id         mmfdb_label_score
   _item_type.code           float
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_label_score
   _mmfdb_schema.column_name value
   _item_description.description
;     The score. Absent when it was not computed -- see status. Never a
;     sentinel: a magic -1 in a float column is indistinguishable from a
;     measurement to everything except the code that wrote it.
;

save__mmfdb_label_score.units
   _item.name                "_mmfdb_label_score.units"
   _item.category_id         mmfdb_label_score
   _item_type.code           ucode
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_label_score
   _mmfdb_schema.column_name units
   _item_description.description
;     An _mmfdb_units code. Most of these scores are `dimensionless`, which is a
;     claim worth making explicitly rather than by omission -- a solvent
;     exposure reported as an area is `angstroms` squared and a proximity as
;     `angstroms`, and which one a definition uses is not guessable.
;

save__mmfdb_label_score.status
   _item.name                "_mmfdb_label_score.status"
   _item.category_id         mmfdb_label_score
   _item_type.code           ucode
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_label_score
   _mmfdb_schema.column_name status
   _item_description.description
;     Why a position has no value, when it has none. This exists so that
;     "excluded on purpose" and "could not be computed" are different facts,
;     which is exactly what an in-band sentinel destroys.
;
    loop_
    _item_enumeration.value
    _item_enumeration.detail
      scored       "a value is present"
      excluded     "the position was deliberately excluded, e.g. a methionine under methionine chemistry"
      unresolved   "the position is not resolved in the structure"
      unavailable  "an input the score needs was missing, e.g. no alignment for conservation"

