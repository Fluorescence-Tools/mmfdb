   _item.name                "_mmfdb_operation.operation_id"
   _item.category_id         mmfdb_operation
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_operation
   _mmfdb_schema.column_name operation_id

save__mmfdb_operation.operation_type
   _item.name                "_mmfdb_operation.operation_type"
   _item.category_id         mmfdb_operation
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_operation
   _mmfdb_schema.column_name operation_type
    loop_
    _item_enumeration.value
      measurement_import
      validation
      burst_selection
      filtering
      fcs_correlation
      microtime_histogram
      tcspc_fitting
      model_fitting
      ndxplorer_selection
      ndxplorer_clustering
      project_snapshot
      project_restore
      archive_export
      tcspc_histogram_computation
      pda_histogram_computation
      pch_histogram_computation
      fcs_correlation_load
      tcspc_curve_load
      histogram_construction
      background_correction
      image_analysis
      population_selection
      calibration
      microtime_shift
      import
      burst_filtering
      gmm_fitting
      analysis
      fitting
      project_archive
      local_fit
      global_fit
      project
      analysis_run
      external_tool
      burst_fusion
      burst_variance_analysis
      burst_2cde
      burst_lifetime_fitting
      burst_correlation
      photon_hmm
      pixel_lifetime_fitting
      molecule_localization
      phasor_analysis
      number_and_brightness
      image_correlation_spectroscopy
      flow_field_estimation
      resolution_estimation
      drift_correction
      particle_tracking
      colocalization
      psf_determination
      region_detection
      pda_burst_likelihood

save__mmfdb_operation.algorithm
   _item.name                "_mmfdb_operation.algorithm"
   _item.category_id         mmfdb_operation
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_operation
   _mmfdb_schema.column_name algorithm
   _item_description.description
;     WHICH algorithm carried out this _mmfdb_operation.operation_type.
;
;     `operation_type` says what was done and is deliberately coarse, because
;     it is the join key: everything that produces a per-burst lifetime is
;     `burst_lifetime_fitting`, so a reader can find them all without knowing
;     how any of them worked.  That coarseness is a problem for the reader who
;     does care -- a maximum-likelihood lifetime, a phasor lifetime and a
;     moment-derived lifetime are not the same estimator, do not have the same
;     bias, and must not be pooled into one histogram.  Recording the estimator
;     is what lets them be told apart without parsing settings_json, whose keys
;     differ per implementation and are not a controlled vocabulary.
;
;     Two operations of the same type and different algorithm are different
;     analyses, and a reader may keep both.  Two of the same type AND the same
;     algorithm differing only in settings are re-runs, distinguished by
;     _mmfdb_operation.settings_hash.
;
;     Absent means unrecorded, not "the usual one".  A writer that knows its
;     estimator says so; nothing infers one.
;
    loop_
    _item_enumeration.value
    _item_enumeration.detail
      mle                "maximum likelihood, the burst-wise TCSPC estimator (fit23 and its family)"
      least_squares      "chi-square minimisation against a convolved model"
      maximum_entropy    "maximum-entropy lifetime distribution"
      phasor             "frequency-domain phasor transform; no fit"
      moments            "moment-derived, e.g. a mean micro time as a lifetime proxy"
      bayesian           "posterior sampling or MAP with priors"
      sliding_window     "fixed-rate threshold over a sliding photon window"
      cusum_sprt         "cumulative-sum / sequential probability ratio change detection"
      maxtree            "max-tree / component-tree over the rate signal"
      bayesian_blocks    "Bayesian blocks segmentation"
      kalman             "Kalman-filtered rate with a threshold"
      bocpd              "Bayesian online change-point detection"
      coincident         "coincidence between two or more channels"
      multi_tau          "multi-tau (logarithmic lag) correlation"
      direct_correlation "direct pairwise correlation over a linear lag axis"
      baum_welch         "expectation-maximisation for a hidden Markov model"
      viterbi            "most-likely state path"
      variational        "variational Bayes"
      neural_surrogate   "amortised neural estimator trained on simulation"
      kernel_density     "kernel-density estimate over photon arrival times"
      variance           "variance of a sub-burst statistic (e.g. BVA)"
      gaussian_prompt_fit    "instrument response taken as a Gaussian fitted to the measured prompt, using the rising edge only -- the falling edge is fluorescence, not response"
      skew_normal_prompt_fit "as gaussian_prompt_fit, with a skew-normal, which follows the tail a real prompt carries"
      measured_prompt        "the measured prompt used directly, baseline-subtracted and not fitted"
      recurrence_probability "same-molecule probability from the inter-burst lag distribution, thresholded (burst fusion)"

save__mmfdb_operation.status
   _item.name                "_mmfdb_operation.status"
