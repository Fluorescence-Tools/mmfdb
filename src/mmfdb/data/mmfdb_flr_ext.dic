########################################
## mmfdb_protocol (PRD-14 LIMS P3)       #
########################################

save_mmfdb_protocol
   _category.id              mmfdb_protocol
   _category.description
;     A named, versioned procedure (measurement / processing / analysis) that
;     operations reference, so every recorded operation names the exact procedure +
;     version it executed ("re-run protocol X v3").  Append-only by version: editing
;     a protocol creates a new row (new protocol_id) with version = max+1 for that
;     name; operations keep the version they ran.  The parameter schema is the
;     operation_type's declared schema (mmfdb_operation_parameter_def, PRD-11) — no
;     forked parameter stack.
;
   _category.mandatory_code  no
   _category_key.name        "_mmfdb_protocol.protocol_id"

save__mmfdb_protocol.protocol_id
   _item.name                "_mmfdb_protocol.protocol_id"
   _item.category_id         mmfdb_protocol
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_protocol
   _mmfdb_schema.column_name protocol_id

save__mmfdb_protocol.name
   _item.name                "_mmfdb_protocol.name"
   _item.category_id         mmfdb_protocol
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_protocol
   _mmfdb_schema.column_name name
   _item_description.description
;     The protocol's stable name; shared across versions (UNIQUE with version,
;     enforced by the repository).

save__mmfdb_protocol.version
   _item.name                "_mmfdb_protocol.version"
   _item.category_id         mmfdb_protocol
   _item_type.code           int
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_protocol
   _mmfdb_schema.column_name version

save__mmfdb_protocol.category
   _item.name                "_mmfdb_protocol.category"
   _item.category_id         mmfdb_protocol
   _item_type.code           code
   _item.mandatory_code      yes
   _mmfdb_schema.table_name  mmfdb_protocol
   _mmfdb_schema.column_name category
    loop_
    _item_enumeration.value
      measurement
      processing
      analysis

save__mmfdb_protocol.description
   _item.name                "_mmfdb_protocol.description"
   _item.category_id         mmfdb_protocol
   _item_type.code           text
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_protocol
   _mmfdb_schema.column_name description

save__mmfdb_protocol.operation_type
   _item.name                "_mmfdb_protocol.operation_type"
   _item.category_id         mmfdb_protocol
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_protocol
   _mmfdb_schema.column_name operation_type
   _item_description.description
;     The PRD-11 operation kind this protocol realizes; its declared parameter
;     schema (mmfdb_operation_parameter_def) is the protocol's parameter schema.

save__mmfdb_protocol.setup_id
   _item.name                "_mmfdb_protocol.setup_id"
   _item.category_id         mmfdb_protocol
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_protocol
   _mmfdb_schema.column_name setup_id
   _mmfdb_schema.foreign_key  mmfdb_setup(setup_id)

save__mmfdb_protocol.created_by_user_id
   _item.name                "_mmfdb_protocol.created_by_user_id"
   _item.category_id         mmfdb_protocol
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_protocol
   _mmfdb_schema.column_name created_by_user_id
   _mmfdb_schema.foreign_key  flr_sample_users(user_id)

save__mmfdb_protocol.is_public
   _item.name                "_mmfdb_protocol.is_public"
   _item.category_id         mmfdb_protocol
