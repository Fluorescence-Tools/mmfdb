   _item_type.code           text
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_event_log
   _mmfdb_schema.column_name payload_json
   _item_description.description
;     JSON-encoded enriched action payload (opaque to the database).

save__mmfdb_event_log.source_uid
   _item.name                "_mmfdb_event_log.source_uid"
   _item.category_id         mmfdb_event_log
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_event_log
   _mmfdb_schema.column_name source_uid

save__mmfdb_event_log.target_uid
   _item.name                "_mmfdb_event_log.target_uid"
   _item.category_id         mmfdb_event_log
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_event_log
   _mmfdb_schema.column_name target_uid

save__mmfdb_event_log.operation_id
   _item.name                "_mmfdb_event_log.operation_id"
   _item.category_id         mmfdb_event_log
   _item_type.code           code
   _item.mandatory_code      no
   _mmfdb_schema.table_name  mmfdb_event_log
   _mmfdb_schema.column_name operation_id
   _mmfdb_schema.foreign_key mmfdb_operation(operation_id) ON DELETE SET NULL
